# Node Environment
NODE_ENV=development
PORT=5000

# Client Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# PostgreSQL Database Configuration
POSTGRES_USER=taskforge_admin
POSTGRES_PASSWORD=taskforge_password_2026
POSTGRES_DB=taskforge_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://taskforge_admin:taskforge_password_2026@postgres:5432/taskforge_db?schema=public

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://redis:6379

# JWT Secrets
