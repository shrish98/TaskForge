generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum TaskStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TaskType {
  FILE_PROCESSING
  DATA_EXPORT
  REPORT_GENERATION
  WEB_SCRAPE
  NOTIFICATION_DISPATCH
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tasks         Task[]
  refreshTokens RefreshToken[]

  @@index([email])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  type        TaskType   @default(FILE_PROCESSING)
  status      TaskStatus @default(PENDING)
  priority    Int        @default(1)
  payload     Json?
  result      Json?
  error       String?
  attempts    Int        @default(0)
  maxAttempts Int        @default(3)
  progress    Int        @default(0)
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  taskLogs    TaskLog[]
  artifact    TaskArtifact?
  runs        TaskAttempt[]

  @@index([userId, status])
  @@index([createdAt])
}

model TaskLog {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  level     String
  message   String
  createdAt DateTime @default(now())

  @@index([taskId])
}

// A file produced by a job (PDF report, CSV export). One per task, overwritten on retry.
model TaskArtifact {
  id        String   @id @default(uuid())
  taskId    String   @unique
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

// One row per attempt at running a task, so retries can be shown as separate runs on the
// worker timeline instead of being folded into the task's single start and end time.
model TaskAttempt {
  id        String    @id @default(uuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  number    Int
  worker    String
  outcome   String    @default("RUNNING") // RUNNING, COMPLETED or FAILED
  error     String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([startedAt])
  @@index([taskId])
}
